# Copier ce fichier en .env puis adapter les valeurs.
SECRET_KEY=changer-cette-cle-en-une-valeur-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker-compose expose le port 5433 sur la machine hôte)
POSTGRES_DB=sigaps
POSTGRES_USER=sigaps
POSTGRES_PASSWORD=sigaps
DATABASE_URL=postgres://sigaps:sigaps@127.0.0.1:5433/sigaps

# Stockage privé des documents (hors MEDIA public), relatif à la racine du projet
STOCKAGE_PRIVE_RACINE=prive

# E-mail (en dev, les messages sont affichés dans la console)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=SIGAPS <no-reply@sigaps.local>

# Production uniquement
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=31536000
X_ACCEL_REDIRECT=False
X_ACCEL_PREFIXE=/prive/
